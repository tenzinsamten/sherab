# Copy to .env and fill in with the output of `npx supabase start`
# (or `npx supabase status` if it's already running).

PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Homework push notifications (#92, docs/notifications.md). Optional: while
# any of the VAPID values is empty the feature is off and hidden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_CRON_SECRET=
